# Salin ke .env (JANGAN commit .env). Semua nilai di bawah adalah contoh.
# Dibaca oleh jalanku/core/config.py. Di hosting, isi lewat pengaturan environment layanan.

# dev | test | prod   (prod: tanpa endpoint /api/dev/*, cookie Secure, HSTS)
JALANKU_MODE=dev
# Folder data (SQLite + foto). Di produksi WAJIB di disk persisten.
JALANKU_DATA=./var
# URL publik aplikasi (dipakai di email & paket penerusan)
JALANKU_URL_DASAR=http://localhost:8000
# IP reverse proxy yang boleh mengirim X-Forwarded-For (dipisah koma). Isi saat di-deploy di balik proxy.
JALANKU_PROXY_TEPERCAYA=127.0.0.1

# Model AI (modul ai). 0 = semua laporan ke antrean Admin (NFR-REL-02)
JALANKU_AI_AKTIF=1
# Kosongkan untuk memakai threshold dari model (BR-07: 0.80 dan 0.708)
JALANKU_AI_THRESHOLD_CONFIDENCE=
JALANKU_AI_THRESHOLD_KEMIRIPAN=

# BR-08: status Selesai wajib foto setelah perbaikan (1/0)
JALANKU_WAJIB_FOTO_SELESAI=1

# Email verifikasi (modul akun). Kosong = email dicetak ke log (hanya dev)
JALANKU_SMTP_HOST=
JALANKU_SMTP_PORT=587
JALANKU_SMTP_USER=
JALANKU_SMTP_PASSWORD=
JALANKU_EMAIL_PENGIRIM=JalanKu <noreply@contoh.id>
